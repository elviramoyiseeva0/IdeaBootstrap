@using Recipe.ViewModel
@model RecipeViewModel
@{
    ViewData["Title"] = "Create";
}

<div class="text-center">
    <form asp-controller="Home" asp-action="Index" method="post">

        <div class="form-group">
            <label>Recipe Name:</label><br />
            <input type="text" name="Name" value="@Model.Name" class="form-control" />
        </div>

        <div class="form-group">
            <label>Description:</label><br />
            <textarea name="Description" class="form-control">@Model.Description</textarea>
        </div>

        <div id="ingredients-container">
            @if (Model.Ingredients != null)
            {
                foreach (var item in Model.Ingredients)
                {
                    <div class="ingredient-row">
                        <div class="form-group mt-3">
                            <label>Ingredient:</label><br />
                            <input type="hidden" name="Ingredients[@item.Key].Key" value="@item.Key" />
                            <input type="text" name="Ingredients[@item.Key].Value.Name" value="@item.Value.Name" class="form-control" />
                            <input type="number" name="Ingredients[@item.Key].Value.Quantity" value="@item.Value.Quantity" class="form-control" />
                            <input type="text" name="Ingredients[@item.Key].Value.Unit" value="@item.Value.Unit" class="form-control" />
                            <div class="mt-3">
                                <button type="button" class="btn btn-secondary remove-ingredient">Remove</button>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="mt-3"></div>
        <div class="form-group">
            <button type="button" class="btn btn-success" id="add-ingredient">Add</button>
        </div>

        <div class="mt-3"></div>
        <div class="form-group">
            <input type="submit" value="Надіслати" class="btn btn-primary" />
        </div>

    </form>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        var i = 1000;

        $("#add-ingredient").click(function () {
            var html = '<div class="ingredient-row">' +
                            '<div class="form-group mt-3">' +
                                '<label>New Ingredient:</label><br />' +
                                '<input type="hidden" name="Ingredients[' + i + '].Key" value="' + i + '" />' +
                                '<input type="text" name="Ingredients[' + i + '].Value.Name" class="form-control" placeholder="Name" />' +
                                '<input type="number" name="Ingredients[' + i + '].Value.Quantity" class="form-control" placeholder="Quantity" />' +
                                '<input type="text" name="Ingredients[' + i + '].Value.Unit" class="form-control" placeholder="Unit" />' +
                                '<div class="mt-3">' +
                                    '<button type="button" class="btn btn-secondary remove-ingredient">Remove</button>' +
                                '</div>' +
                            '</div>' +
                       '</div>';
            $("#ingredients-container").append(html);
            i++;
        });

        $(document).on("click", ".remove-ingredient", function () {
            $(this).closest(".ingredient-row").remove();
        });
    </script>
}